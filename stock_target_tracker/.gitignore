# Report output: ignore all generated reports except the published sample report.
# latest.html (personal portfolio) is intentionally untracked — keep it local.
output/*
!output/sample_output.html

# Input whitelist: keep only the sample whitelist CSV.
# Ignore raw portfolio exports and derived whitelists (may contain personal data).
input/*
!input/sample_symbols.csv

# Runtime data (also covered by the root .gitignore, repeated for self-containment)
stock_tracker.db
*.db
__pycache__/